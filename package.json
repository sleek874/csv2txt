{
  "name": "offline-data-conversion",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first offline browser conversion between tabular files and a fixed 208-byte Taiwan-government BIG-5E record format.",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "build": "npm run check && vite build && npm run verify:build",
    "verify": "npm test && npm run build",
    "verify:build": "node scripts/verify-build.mjs",
    "generate:big5e-mapping": "node scripts/generate-big5e-mapping.mjs",
    "generate:testdata": "node --import ./tests/register-typescript.mjs scripts/generate-testdata.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "papaparse": "^5.6.0",
    "string_decoder": "^1.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
